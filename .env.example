# Copy to .env and fill in. Never commit .env.

# --- Yeastar side ---
# Any long random string. Enter the same value as "API Key" on the PBX SMS channel.
YEASTAR_API_KEY=
# Any long random string. Enter the same value as "Secret" on the PBX SMS channel.
YEASTAR_SECRET=
# The "Webhook URL" the PBX shows on the SMS channel.
YEASTAR_WEBHOOK_URL=

# --- Over the Wire / NetSIP side ---
NETSIP_BASE_URL=https://api.overthewire.com.au
# OTW account ID, e.g. SRC12345
NETSIP_ACCOUNT_ID=
# API user (Basic Auth)
NETSIP_USERNAME=
NETSIP_PASSWORD=
# true = send numbers to NetSIP as +61412345678, false = 61412345678
NETSIP_PLUS_PREFIX=true
# Used to expand local numbers such as 0412 345 678
DEFAULT_COUNTRY_CODE=61

# --- Inbound SMS (NetSIP -> PBX) ---
# poll     = ask NetSIP for new inbound messages every POLL_INTERVAL seconds (default)
# callback = NetSIP calls the bridge when a reply arrives (needs the two settings below)
# off      = outbound only
INBOUND_MODE=poll
POLL_INTERVAL=15
# --- Numbers this bridge may use (required) ---
# Comma separated. The bridge only fetches inbound SMS for these numbers and only
# sends from them. Every other number on the NetSIP account is ignored.
NETSIP_NUMBERS=

# Only for INBOUND_MODE=callback
PUBLIC_BASE_URL=
CALLBACK_TOKEN=

# Only for the optional Caddy HTTPS profile in docker-compose.yml
BRIDGE_DOMAIN=

LOG_LEVEL=INFO
